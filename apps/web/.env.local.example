NEXT_PUBLIC_API_URL=

# Image uploads (/api/uploads)
# - Local/dev: if S3 env vars are unset, files are saved under public/uploads (dev-only).
# - Production (e.g. Vercel): S3 is required — local disk is ephemeral/read-only.
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Optional override (CloudFront etc.). Default: https://{bucket}.s3.{region}.amazonaws.com/{key}
# S3_PUBLIC_URL_BASE=
