NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Image uploads (/api/uploads)
# - Local/dev: if S3 env vars are unset, files are saved under public/uploads (dev-only).
# - Production (e.g. Vercel): S3 is required — local disk is ephemeral/read-only.
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Public URL base for returned object URLs (recommended: CloudFront).
# If unset, defaults to https://{bucket}.s3.{region}.amazonaws.com/{key}
# Those URLs only work if objects are anonymously readable (bucket policy), or
# if this points at a CDN that can read a private bucket.
# S3_PUBLIC_URL_BASE=https://d111111abcdef8.cloudfront.net
