{
  "name": "mood-trip",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @mood-trip/database build && pnpm --filter @mood-trip/validators build && pnpm --filter @mood-trip/api dev",
    "dev:web": "pnpm --filter @mood-trip/web dev",
    "dev:admin": "pnpm --filter @mood-trip/admin dev",
    "db:generate": "pnpm --filter @mood-trip/database db:generate",
    "db:migrate": "pnpm --filter @mood-trip/database db:migrate",
    "db:studio": "pnpm --filter @mood-trip/database db:studio",
    "db:seed": "pnpm --filter @mood-trip/database db:seed",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:ci": "pnpm --filter @mood-trip/database db:generate && pnpm --filter @mood-trip/database build && pnpm --filter @mood-trip/validators build && pnpm test",
    "test:watch": "pnpm --filter @mood-trip/web test:watch"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.5.0",
  "devDependencies": {
    "@mood-trip/config": "workspace:^",
    "prettier": "^3.8.4"
  }
}
